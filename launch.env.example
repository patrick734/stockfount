# Copy to launch.env and fill in. Addresses and names only: never put a private key in this file.

# Safe #1 on app.safe.global (Robinhood Chain): proposes and executes every change, each one after 48 hours.
ADMIN_MULTISIG=0x...
# Safe #2, with different owners or threshold: can only pause and lower limits.
GUARDIAN_MULTISIG=0x...
# Written for you by: node tools/wallet.js keeper-secret
KEEPER_ADDRESS=0x...
# The name you gave the dev wallet in: node tools/import-key.js <name>
DEPLOYER_ACCOUNT=stockfount-dev
# Leave empty: the protocol deploys first, and ./set-token.sh adds $FOUNT after the Pons launch.
FOUNT_TOKEN_ADDRESS=
# Optional private RPC (for example Alchemy) if the public one drops connections. Remove the # to use it.
#ROBINHOOD_RPC_URL=
